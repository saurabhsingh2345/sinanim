# ── LLM provider (pick ONE; auto-detected in this order) ──────────────────────
# 1. Groq — FREE, fast, runs open models. Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# 2. OpenAI — paid, highest lesson quality. Uncomment to use.
# OPENAI_API_KEY=

# 3. (no key) → falls back to local Ollama (ollama pull qwen3:8b)

# ── Optional overrides ────────────────────────────────────────────────────────
# Force a provider regardless of which keys are set: groq | openai | ollama
# LLM_PROVIDER=groq

# Pick a specific model. Recommended:
#   Groq:   openai/gpt-oss-120b   (best free lesson quality)
#   OpenAI: gpt-4o
# LLM_MODEL=openai/gpt-oss-120b

# Multi-pass authoring (draft → editor → narration → structural repair).
# On by default for Groq/OpenAI, off for Ollama. Force: 1 = always, 0 = never.
# LLM_DEEP=1
