# ── LLM provider ──────────────────────────────────────────────────────────────
# The app auto-selects a provider: if GROQ_API_KEY is set it uses Groq (FREE,
# fast, open-source Llama models); else OPENAI_API_KEY -> OpenAI; else it falls
# back to a fully-local Ollama install. You can force one with LLM_PROVIDER.

# Recommended: Groq is free. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: paid alternative
# OPENAI_API_KEY=

# Optional overrides
# LLM_PROVIDER=groq            # groq | openai | ollama
# LLM_MODEL=llama-3.3-70b-versatile
# OLLAMA_HOST=http://127.0.0.1:11434

# ── Authoring pipeline ────────────────────────────────────────────────────────
# LLM_DEEP=1                   # force multi-pass authoring (plan → draft →
#                              # critic+judge → narration → lint) even on Ollama;
#                              # 0 disables everywhere. Default: on for hosted.
# LLM_GROUND=0                 # disable execution grounding (running snippets
#                              # server-side to verify terminal output)
# LLM_VISION_QA=1              # opt-in: render keyframes headlessly and have a
#                              # vision model flag visual defects (clipped text,
#                              # overlap, dead space). Needs a vision-capable model.
# LLM_VISION_MODEL=            # override the vision model id

# ── Voiceover ─────────────────────────────────────────────────────────────────
# Narration needs NO configuration: Kokoro TTS (82M, Apache-2.0) runs fully in
# the browser. The ~90 MB voice model downloads once on first use and is cached.
#
# Optional premium voice tiers (extra options appear in the player's voice menu;
# keys stay server-side, sentences are proxied through /api/tts):
# OPENAI_API_KEY=              # gpt-4o-mini-tts (~$0.015 per minute of speech)
# ELEVENLABS_API_KEY=          # ElevenLabs multilingual (quality ceiling)
